# SpendWise AI Backend Environment Configuration

PORT=5000
NODE_ENV=production
CLIENT_URL=https://spendwise-ai.vercel.app

# MongoDB Atlas Database URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/spendwise_db?retryWrites=true&w=majority

# JWT Token Secret & Expiration
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
JWT_EXPIRE=30d

# Cloudinary Storage Credentials
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# OpenAI API Key for Financial Chatbot & Natural Language Expense Processing
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
