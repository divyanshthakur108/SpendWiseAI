# ==================================
# SPENDWISE AI - ENVIRONMENT VARIABLES
# ==================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/spendwise_db?retryWrites=true&w=majority

# Authentication Secret
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRE=30d

# Cloudinary Configuration (Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# OpenAI Configuration (AI Financial Insights & Categorization)
OPENAI_API_KEY=your_openai_api_key_here

# Frontend Application URL
CLIENT_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:5000/api
